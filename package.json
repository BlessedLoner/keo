{
  "name": "keo",
  "productName": "Keo",
  "version": "1.23.0",
  "description": "Keo — a permission-controlled personal AI agent for Windows.",
  "private": true,
  "license": "UNLICENSED",
  "author": "Keo",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "e2e:desktop": "npm run build && node scripts/e2e-desktop.mjs",
    "package:dir": "npm run build && electron-builder --win --dir --publish never",
    "package:win": "npm run build && electron-builder --win --publish never"
  },
